# Camp Scout AI — environment variables
#
# Two groups, loaded differently in development:
#   * `npm run dev` reads ONLY OPENAI_*, STRIPE_* and APP_URL from this file
#     (.env.local). Everything else must be exported in the shell.
#   * `npm start` (production server) reads nothing from .env files; export all
#     of it, or set it as Fly secrets. See README "Running locally".

# ---- Required for any signed-in use (export in the shell) ------------------
# Signs the cs_session cookie. Any string >= 16 chars; rotating it signs
# everyone out.
SESSION_SECRET=change-me-to-at-least-16-random-chars
# Shared secret the signed-in client sends to /api/ask and /api/summary.
# Any string locally.
CAMP_SCOUT_API_TOKEN=your-internal-api-token

# ---- Google sign-in (production server only; `npm run dev` has no OAuth
#      routes — mint a session cookie instead, see README) --------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback
# Comma-separated allow-list. Unset = any Google account may sign in.
# ALLOWED_EMAILS=

# ---- Database (SQLite via better-sqlite3 + Drizzle) --------------------------
# Defaults to ./campscout.sqlite (gitignored). Prod uses the Fly volume.
# DATABASE_PATH=./campscout.sqlite

# ---- Recreation.gov facility data (optional; free key) -----------------------
# https://ridb.recreation.gov/ → sign in → API key. Unset = RIDB lookups skipped.
# RIDB_API_KEY=

# ---- Availability watcher + alerts (optional) --------------------------------
# WATCHER_ENABLED=true
# WATCH_POLL_INTERVAL_SECONDS=300
# WATCH_SMS_ENABLED=false
# WATCH_MAX_SMS_PER_TICK=5
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# TWILIO_MESSAGING_SERVICE_SID=
# RESEND_API_KEY=
# EMAIL_FROM=
# PUSHOVER_APP_TOKEN=
# PUSHOVER_USER_KEY=

# ---- OpenAI answer provider (read from .env.local by the dev server) ---------
# "fake" (default) answers from retrieved context with no API call — $0.
OPENAI_ANSWER_PROVIDER=fake
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_CONTEXT_TOKENS=2000
# OPENAI_MAX_OUTPUT_TOKENS=800

# ---- AI Operations (server-side only) --------------------------------------
# Master switch for live OpenAI calls. Keep the budget limits set when true.
AI_ENABLED=false
# AI_MAINTENANCE_MODE=false
# AI_DAILY_REQUEST_LIMIT=500
# AI_DAILY_INPUT_TOKEN_LIMIT=1000000
# AI_DAILY_OUTPUT_TOKEN_LIMIT=500000
# AI_DAILY_DOLLAR_LIMIT=5.00
# AI_DAILY_BUDGET_USD=5.00
# AI_MAX_PROMPT_TOKENS=1500
# AI_MAX_REQUEST_COST_USD=0.05
# AI_SLOW_REQUEST_MS=5000
# AI_HOURLY_REQUEST_LIMIT=100
# AI_HOURLY_TOKEN_LIMIT=200000
# AI_HOURLY_DOLLAR_LIMIT=1.00
# AI_AUDIT_LOG_PATH=.ai-audit/audit-log.jsonl
# AI_AUDIT_LOG_RETENTION_DAYS=30
# AI_INPUT_COST_PER_MILLION=0.15
# AI_OUTPUT_COST_PER_MILLION=0.60

# ---- Stripe donations (read from .env.local by the dev server; optional) ----
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_PRICE_5=price_your_5_dollar_price_id
STRIPE_PRICE_10=price_your_10_dollar_price_id
STRIPE_PRICE_25=price_your_25_dollar_price_id
APP_URL=https://campscout.terapak.com

# ---- Request guardrails for /api/ask and /api/summary (optional) ------------
# API_MAX_QUESTION_LENGTH=500
# API_MAX_TOP_DOCUMENT_COUNT=5
# API_MAX_JSON_BODY_BYTES=16384
# API_RATE_LIMIT_ASK_PER_MINUTE=20
# API_RATE_LIMIT_SUMMARY_PER_MINUTE=10

# ---- Google Analytics 4 (build-time, public) --------------------------------
# Measurement ID (G-XXXXXXX). Empty = analytics off. Only runs on the
# production host regardless.
VITE_GA_MEASUREMENT_ID=
