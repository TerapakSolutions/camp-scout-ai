# local ignore rules
node_modules
dist
.DS_Store
.env
.env.local

# generated outputs
coverage/
.ai-audit/
# Standardize on npm — a stray pnpm install skews jest package versions
pnpm-lock.yaml

# Build output written into docs/ by `npm run build` (served by nothing —
# Fly serves dist/). The hand-maintained docs/*.md files stay tracked.
docs/assets/
docs/index.html
docs/sitemap.xml
docs/robots.txt
docs/google*.html

# Local dev SQLite (prod uses the Fly volume)
campscout.sqlite
campscout.sqlite-shm
campscout.sqlite-wal

# Claude Code: personal overrides stay local (the shared hooks live in .claude/settings.json)
.claude/settings.local.json
.claude/*.local.*

# Cypress run output
cypress/screenshots/
cypress/videos/
